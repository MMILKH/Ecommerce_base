<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="model.RigaCarrello" table="RIGA_CARRELLO">
        <id name="id" column="ID" type="int">
            <generator class="native"/>
        </id>

        <property name="quantita" column="QUANTITA" type="int" not-null="true"/>

        <property name="dataCreazione" column="DATA_CREAZIONE" type="timestamp" not-null="true"/>

        <property name="ultimaModifica" column="DATA_ULTIMA_MODIFICA" type="timestamp" not-null="true"/>

        <many-to-one name="carrello" class="model.Carrello" not-null="true">
            <column name="CARRELLO_ID"/>
        </many-to-one>


        <many-to-one name="prodotto" class="model.Prodotto" not-null="true" lazy="false">
            <column name="PRODOTTO_ID"/>
        </many-to-one>

    </class>

</hibernate-mapping>