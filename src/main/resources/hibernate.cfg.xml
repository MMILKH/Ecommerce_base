<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <property name="hibernate.connection.driver_class">oracle.jdbc.OracleDriver</property>
        <property name="hibernate.connection.url">jdbc:oracle:thin:@localhost:1521:xe</property>
        <property name="hibernate.connection.username">ecommerce_db</property>
        <property name="hibernate.connection.password">password123</property>
        <property name="show_sql">true</property>
        <property name="format_sql">true</property>
        <property name="hbm2ddl.auto">validate</property>

        <mapping resource="utente.hbm.xml"/>
        <mapping resource="stato.hbm.xml"/>
        <mapping resource="ruolo.hbm.xml"/>
        <mapping resource="carrello.hbm.xml"/>
        <mapping resource="prodotto.hbm.xml"/>
        <mapping resource="riga_carrello.hbm.xml"/>


    </session-factory>
</hibernate-configuration>