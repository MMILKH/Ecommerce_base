<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="model.Carrello" table="CARRELLO">
        <id name="id" column="ID" type="int">
            <generator class="native"/>
        </id>


        <property name="dataCreazione" column="DATA_CREAZIONE" type="timestamp"/>
        <property name="ultimoAggiornamento" column="ULTIMO_AGGIORNAMENTO" type="timestamp"/>

        <many-to-one name="utente" class="model.Utente">
            <column name="UTENTE_ID"/>
        </many-to-one>

    </class>


</hibernate-mapping>