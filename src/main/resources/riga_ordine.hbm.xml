<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="model.RigaOrdine" table="RIGA_ORDINE">
        <id name="id" column="ID" type="int">
            <generator class="identity"/>
        </id>

        <property name="quantita" column="QUANTITA" type="int" not-null="true"/>
        <property name="prezzoUnitario" column="PREZZO_UNITARIO" type="big_decimal" not-null="true"/>
        <property name="prezzoRiga" column="PREZZO_RIGA" type="big_decimal" not-null="true"/>
        <property name="rigaCarrelloId" column="RIGA_CARRELLO_ID" type="int" not-null="true"/>
        <property name="dataCreazione" column="DATA_CREAZIONE" type="timestamp" not-null="true"/>


        <many-to-one name="ordine" class="model.Ordine" not-null="true">
            <column name="ORDINE_ID"/>
        </many-to-one>


        <many-to-one name="prodotto" class="model.Prodotto" not-null="true" lazy="false">
            <column name="PRODOTTO_ID"/>
        </many-to-one>

    </class>

</hibernate-mapping>